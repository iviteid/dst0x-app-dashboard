# Browser-safe Supabase project settings (Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Optional: authenticated backend API that reads telemetry from MongoDB.
# Do not put a mongodb:// URI, database password, service_role key, or JWT
# signing secret in any VITE_* variable.
VITE_TELEMETRY_API_URL=https://api.example.com/v1/sensor-records
VITE_TELEMETRY_API_KEY=your_api_key_here
